  fondosFinales:
  - {fileID: 21300000, guid: d4f3baaa829bc2b49bd4effd7c7aec0a, type: 3}
  - {fileID: 21300000, guid: 5f68823aa4f7e43428e52531d34f6fda, type: 3}
  - {fileID: 21300000, guid: 4c860d799eb2eb142bc9690df5b03759, type: 3}
  - {fileID: 21300000, guid: 45528ae2eef7da14cbebc244888cf610, type: 3}
  - {fileID: 21300000, guid: b1573c266fcdaab4fadc57ff65deecb5, type: 3}
  textosFinales:
  - 'Empieza la aventura! '
  - "Ni todas las piedras del universo podr\xE1n detenerme."
  - 1
  - 1
  - 1
  spritePrologoComic: {fileID: 21300000, guid: c829054d05a69ce4e94c56f59b974bdc, type: 3}
  textoStarWarsIntro: "\xA1INVASI\xD3N EN EL SISTEMA SOLAR! Una devastadora AMENAZA
    ALIEN\xCDGENA ha aniquilado a la NASA y destruido las defensas globales, dejando
    a la Tierra indefensa y sumida en el p\xE1nico.\n\nSin tecnolog\xEDa ni ej\xE9rcito,
    el gobierno detecta una ins\xF3lita lectura de energ\xEDa en un garaje residencial:
    un humilde PANADERO ha construido en secreto su propia astronave con chatarra
    reciclada.\n\nCon las manos manchadas de harina y el motor en marcha, \xA1este
    inesperado h\xE9roe despega hacia lo desconocido como la \xFAltima esperanza
    de la humanidad!..."
